# Imagen de la UI de Guatemala a partir de build/webapp generado con Grunt
# (docker-compose.build-gtm.yml). Parte de la imagen de producción gtm.5, que ya trae
# nginx, Node.js (registro en consul) y envsubst: así no depende de apt-get.
ARG BASE_IMAGE=ghcr.io/ghscpsm-cam/openlmis-gtm-ui:8.0.1-gtm.5
FROM ${BASE_IMAGE}

ADD nginx.conf /etc/nginx/conf.d/default.conf
# Reemplaza por completo la UI anterior (sin mezclar archivos viejos y nuevos).
RUN rm -rf /usr/share/nginx/html/*
COPY build/webapp /usr/share/nginx/html
COPY run.sh /run.sh
RUN chmod +x /run.sh
